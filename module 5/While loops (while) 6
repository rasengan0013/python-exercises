import random

points = int(input("How many random points to generate? "))

points_inside = 0

for i in range(points):
    x = random.uniform(-1, 1)
    y = random.uniform(-1, 1)
    
    if x**2 + y**2 < 1:
        points_inside += 1

pi_approximation = 4 * points_inside / points

print(f"Number of points generated: {points}")
print(f"Points inside circle: {points_inside}")
print(f"Approximation of pi: {pi_approximation}")