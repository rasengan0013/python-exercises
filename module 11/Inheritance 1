class Publication:
    def __init__(self, name):
        self.name = name

class Book(Publication):
    def __init__(self, name, author, pages):
        super().__init__(name)
        self.author, self.pages = author, pages

    def print_information(self):
        print(f"Book: {self.name}, Author: {self.author}, Pages: {self.pages}")

class Magazine(Publication):
    def __init__(self, name, editor):
        super().__init__(name)
        self.editor = editor

    def print_information(self):
        print(f"Magazine: {self.name}, Editor: {self.editor}")

Magazine("Donald Duck", "Aki Hyyppä").print_information()
Book("Compartment No. 6", "Rosa Liksom", 192).print_information()