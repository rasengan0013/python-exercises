import random

class Car:
    def __init__(self, reg, max_speed):
        self.reg = reg
        self.max_speed = max_speed
        self.speed = 0
        self.distance = 0

    def accelerate(self, change):
        self.speed = max(0, min(self.max_speed, self.speed + change))

    def drive(self, hours):
        self.distance += self.speed * hours

cars = [Car(f"ABC-{i}", random.randint(100, 200)) for i in range(1, 11)]

while not any(c.distance >= 10000 for c in cars):
    for c in cars:
        c.accelerate(random.randint(-10, 15))
        c.drive(1)

print(f"{'Reg':<8} | {'MaxSpd':<8} | {'CurSpd':<8} | {'Distance':<10}")
print("-" * 42)
for c in sorted(cars, key=lambda x: x.distance, reverse=True):
    print(f"{c.reg:<8} | {c.max_speed:<8} | {c.speed:<8} | {c.distance:<10.1f}")